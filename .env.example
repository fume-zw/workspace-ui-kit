# Supabase（タスク管理ワークスペース本体）
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Watch / ショートカット用 inbox（Cookie なし。Vercel の Environment Variables に置く）
# INBOX_TOKEN は 128bit 以上のランダム文字列。Authorization: Bearer で送る。
# ICS 用の鍵とは別にすること。
INBOX_TOKEN=
INBOX_USER_ID=
SUPABASE_SERVICE_ROLE_KEY=

# 本番デプロイ時は Supabase Dashboard → Authentication → URL Configuration に以下を登録:
#   Site URL: https://your-domain.example
#   Redirect URLs:
#     http://localhost:3000/auth/callback
#     https://your-domain.example/auth/callback
