# Supabase（タスク管理ワークスペース本体）
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Watch / ショートカット用 inbox（Cookie なし。Vercel の Environment Variables に置く）
# INBOX_TOKEN は 128bit 以上のランダム文字列。Authorization: Bearer で送る。
# ICS 用の鍵とは別にすること。
INBOX_TOKEN=
INBOX_USER_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Apple / Google カレンダー購読用（URL が鍵。inbox とは別）
ICS_TOKEN=

# 週のふりかえり（月曜 08:00 JST に LINE。直前の月曜〜日曜）
# Vercel に置く。Gemini が 429 のときは定型文で送る。
GEMINI_API_KEY=
# 省略時は gemini-2.0-flash
GEMINI_MODEL=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE の送り先ユーザー ID（LINE_USER_ID でも可）
LINE_TO=
# Vercel Cron 用。設定すると GET /api/weekly-review に Bearer で付く
CRON_SECRET=

# 手動実行や GitHub Actions から叩く場合の本番 URL 例:
#   POST https://your-domain.example/api/weekly-review
#   Authorization: Bearer $INBOX_TOKEN
#   ?period=previous（既定・先週） / current（今週ここまで）
#   ?dry=1 で LINE に送らず本文だけ返す

# 本番デプロイ時は Supabase Dashboard → Authentication → URL Configuration に以下を登録:
#   Site URL: https://your-domain.example
#   Redirect URLs:
#     http://localhost:3000/auth/callback
#     https://your-domain.example/auth/callback
